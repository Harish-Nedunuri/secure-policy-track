        <mxCell id="j8jRsDvp5Zwr_lb-9yIc-1" value="&#xa;    &quot;error_codes&quot;: [&#xa;      {&#xa;        &quot;code&quot;: 400,&#xa;        &quot;message&quot;: &quot;Bad Request&quot;,&#xa;        &quot;error&quot;: &quot;invalid_request&quot;,&#xa;        &quot;description&quot;: &quot;The request is missing a required parameter, includes an unsupported parameter value, or is malformed.&quot;&#xa;      },&#xa;      {&#xa;        &quot;code&quot;: 400,&#xa;        &quot;message&quot;: &quot;Bad Request&quot;,&#xa;        &quot;error&quot;: &quot;invalid_grant&quot;,&#xa;        &quot;description&quot;: &quot;The provided authorization grant (e.g., authorization code, resource owner credentials) is invalid, expired, or revoked.&quot;&#xa;      },&#xa;      {&#xa;        &quot;code&quot;: 400,&#xa;        &quot;message&quot;: &quot;Bad Request&quot;,&#xa;        &quot;error&quot;: &quot;invalid_token&quot;,&#xa;        &quot;description&quot;: &quot;The access token provided is expired, revoked, malformed, or invalid for other reasons.&quot;&#xa;      },&#xa;      {&#xa;        &quot;code&quot;: 400,&#xa;        &quot;message&quot;: &quot;Bad Request&quot;,&#xa;        &quot;error&quot;: &quot;unsupported_grant_type&quot;,&#xa;        &quot;description&quot;: &quot;The authorization grant type is not supported by the authorization server.&quot;&#xa;      },&#xa;      {&#xa;        &quot;code&quot;: 400,&#xa;        &quot;message&quot;: &quot;Bad Request&quot;,&#xa;        &quot;error&quot;: &quot;invalid_scope&quot;,&#xa;        &quot;description&quot;: &quot;The requested scope is invalid, unknown, or malformed.&quot;&#xa;      },&#xa;      {&#xa;        &quot;code&quot;: 401,&#xa;        &quot;message&quot;: &quot;Unauthorized&quot;,&#xa;        &quot;error&quot;: &quot;invalid_client&quot;,&#xa;        &quot;description&quot;: &quot;Client authentication failed (e.g., incorrect client credentials or unsupported authentication method).&quot;&#xa;      },&#xa;      {&#xa;        &quot;code&quot;: 401,&#xa;        &quot;message&quot;: &quot;Unauthorized&quot;,&#xa;        &quot;error&quot;: &quot;invalid_grant&quot;,&#xa;        &quot;description&quot;: &quot;The provided authorization grant is invalid, expired, or revoked.&quot;&#xa;      },&#xa;      {&#xa;        &quot;code&quot;: 403,&#xa;        &quot;message&quot;: &quot;Forbidden&quot;,&#xa;        &quot;error&quot;: &quot;insufficient_scope&quot;,&#xa;        &quot;description&quot;: &quot;The request requires higher privileges than provided by the access token.&quot;&#xa;      },&#xa;      {&#xa;        &quot;code&quot;: 404,&#xa;        &quot;message&quot;: &quot;Not Found&quot;,&#xa;        &quot;error&quot;: &quot;not_found&quot;,&#xa;        &quot;description&quot;: &quot;The requested resource could not be found.&quot;&#xa;      },&#xa;      {&#xa;        &quot;code&quot;: 405,&#xa;        &quot;message&quot;: &quot;Method Not Allowed&quot;,&#xa;        &quot;error&quot;: &quot;method_not_allowed&quot;,&#xa;        &quot;description&quot;: &quot;The HTTP method is not allowed for this resource.&quot;&#xa;      },&#xa;      {&#xa;        &quot;code&quot;: 429,&#xa;        &quot;message&quot;: &quot;Too Many Requests&quot;,&#xa;        &quot;error&quot;: &quot;rate_limit_exceeded&quot;,&#xa;        &quot;description&quot;: &quot;The client has exceeded the allowed number of requests. Try again later.&quot;&#xa;      },&#xa;      {&#xa;        &quot;code&quot;: 500,&#xa;        &quot;message&quot;: &quot;Internal Server Error&quot;,&#xa;        &quot;error&quot;: &quot;server_error&quot;,&#xa;        &quot;description&quot;: &quot;The server encountered an unexpected condition that prevented it from fulfilling the request.&quot;&#xa;      }&#xa;    ]&#xa;  }&#xa;}" style="text;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=17;strokeWidth=0;" parent="1" vertex="1">
