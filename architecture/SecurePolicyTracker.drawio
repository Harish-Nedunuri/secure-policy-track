        <mxCell id="2-EfgcQW_2WKCT6kMJmK-18" value="&lt;div style=&quot;font-size: 16px;&quot;&gt;Example Project Structure&lt;/div&gt;&lt;ol style=&quot;font-size: 16px;&quot;&gt;&lt;li style=&quot;font-size: 16px;&quot;&gt;.git&lt;/li&gt;&lt;li style=&quot;font-size: 16px;&quot;&gt;.gitignore&lt;/li&gt;&lt;li style=&quot;font-size: 16px;&quot;&gt;.env&lt;/li&gt;&lt;li style=&quot;font-size: 16px;&quot;&gt;.Dockerfile&lt;/li&gt;&lt;li style=&quot;font-size: 16px;&quot;&gt;.dockerenv&lt;/li&gt;&lt;li style=&quot;font-size: 16px;&quot;&gt;dockercompose.yml&lt;/li&gt;&lt;li style=&quot;font-size: 16px;&quot;&gt;core_package and router.py files&lt;/li&gt;&lt;li style=&quot;font-size: 16px;&quot;&gt;package_setup.json&lt;/li&gt;&lt;li style=&quot;font-size: 16px;&quot;&gt;setup.py&lt;/li&gt;&lt;li style=&quot;font-size: 16px;&quot;&gt;fastapi entrypoint : main.py&lt;/li&gt;&lt;li style=&quot;font-size: 16px;&quot;&gt;.github/workflows&lt;/li&gt;&lt;li style=&quot;font-size: 16px;&quot;&gt;documentation&lt;/li&gt;&lt;/ol&gt;&lt;div style=&quot;font-size: 16px;&quot;&gt;&lt;br style=&quot;font-size: 16px;&quot;&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;fontSize=16;" vertex="1" parent="2-EfgcQW_2WKCT6kMJmK-17">
